{
  "name": "target365/sdk",
  "description": "Target365 SDK",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.0 || ^8.0",
    "psr/log": "^1.0 || ^3.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Target365",
      "email": "support@target365.no"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^9.6.33",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "monolog/monolog": "^2.0 || ^3.0",
    "symfony/yaml": "^6.4.45 || ^7.4.18 || ^8.1.6",
    "ramsey/uuid": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Target365\\ApiSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Target365\\ApiSdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit",
    "test-integration": "phpunit --testsuite Integration",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "phpstan-deprecations": "phpstan analyse --memory-limit=1G -c phpstan-deprecations.neon.dist"
  }
}
